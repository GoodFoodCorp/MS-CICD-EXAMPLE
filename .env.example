# Auth Service Configuration
PORT=8081
ENV=development

# Database Configuration
DATABASE_URL=host=auth-db user=user password=YOUR_PASSWORD dbname=auth_db port=5432 sslmode=disable
POSTGRES_USER=user
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=auth_db

JWT_SECRET=YOUR_SECRET_KEY_HERE
# Clé de signature des refresh tokens (dérivée de JWT_SECRET si vide).
# Les refresh tokens ne sont jamais vérifiables par les autres services.
JWT_REFRESH_SECRET=
JWT_ISSUER=goodfood-auth
JWT_AUDIENCE=goodfood-api

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=YOUR_SMTP_USER
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_SENDER=no-reply@your-domain.com

USER_SERVICE_URL=http://user-service:8087
# Secret partagé des appels service-à-service (/internal/*, en-tête X-Service-Key)
SERVICE_API_KEY=YOUR_SERVICE_KEY
# Compteurs du rate limit partagés entre réplicas (vide = mémoire locale)
REDIS_URL=
# CIDR autorisés à transmettre X-Forwarded-For (défaut : réseaux privés)
TRUSTED_PROXIES=
# Force le flag Secure des cookies (défaut : true si ENV=production ou front https)
COOKIE_SECURE=
AUTO_VERIFY_EMAIL=true

# ── Connexion via un fournisseur externe (optionnel) ──
# Les boutons n'apparaissent dans le front que si les clés sont renseignées.
# Google  : https://console.cloud.google.com/apis/credentials
# Microsoft : https://portal.azure.com → Entra ID → Inscriptions d'applications
# URL de redirection à déclarer chez le fournisseur :
#   http://localhost:3000/api/auth/oauth/google/callback
#   http://localhost:3000/api/auth/oauth/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Laisser vide = endpoint multi-tenant : l'email Microsoft n'est alors jamais
# assez fiable pour rejoindre un compte existant (attaque nOAuth). Renseigner
# votre tenant pour que son annuaire fasse autorité.
MICROSOFT_TENANT_ID=
OAUTH_REDIRECT_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
